---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { url } from "../../site";

export async function getStaticPaths() {
  const posts = await getCollection("writing");
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<Base title={entry.data.title} description={entry.data.summary} current="writing">
  <article>
    <header class="page-head">
      <span class="label">{date} · {entry.data.kind}</span>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
    </header>
    <div class="prose"><Content /></div>
    <nav class="story-next" aria-label="More writing">
      <a href={url("writing/")}><span class="label">Back</span><span class="t">All writing</span></a>
    </nav>
  </article>
</Base>
